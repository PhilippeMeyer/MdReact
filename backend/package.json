{
  "name": "md-convert",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js"
  },
  "nodemonConfig": {
    "watch": [
      "."
    ],
    "ext": "js,json",
    "ignore": [
      "node_modules/**",
      "*.pdf",
      "package-lock.json"
    ],
    "delay": 250
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "marked": "^16.3.0",
    "pdfkit": "^0.17.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
