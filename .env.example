# Where the PDF backend lives. Used by the Vite dev-server proxy (see
# vite.config.js). Copy to .env to override.
VITE_PDF_SERVER=http://localhost:4000

# Optional: call the backend directly instead of going through the proxy.
# Leave unset in development so requests stay same-origin.
# VITE_API_URL=http://localhost:4000/api/generatePDF
